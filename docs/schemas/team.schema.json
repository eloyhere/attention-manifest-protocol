{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amp.dev/schema/0.1/team.schema.json",
  "title": "AMP team objects (team-manifest | commitment-record)",
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "required": ["amp", "kind", "id", "version", "members", "max_depth", "max_fanout", "budget", "termination", "attested_at"],
      "properties": {
        "amp": { "const": "0.1" },
        "kind": { "const": "team-manifest" },
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "version": { "type": "integer", "minimum": 1 },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "role", "authority"],
            "properties": {
              "id": { "$ref": "common.schema.json#/$defs/id" },
              "role": { "type": "string" },
              "capabilities": { "type": "array", "items": { "type": "string" } },
              "authority": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": false
          }
        },
        "max_depth": { "type": "integer", "minimum": 0, "maximum": 2 },
        "max_fanout": { "type": "integer", "minimum": 1, "maximum": 10 },
        "budget": { "$ref": "common.schema.json#/$defs/budget" },
        "termination": { "type": "string", "enum": ["verified", "budget", "stall", "authority"] },
        "attested_at": { "$ref": "common.schema.json#/$defs/ts" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["amp", "kind", "id", "parties", "proposition", "satisfaction", "status", "proposed_by", "created"],
      "properties": {
        "amp": { "const": "0.1" },
        "kind": { "const": "commitment-record" },
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "parties": { "type": "array", "minItems": 2, "items": { "$ref": "common.schema.json#/$defs/id" } },
        "proposition": { "type": "string", "minLength": 1 },
        "satisfaction": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/criterion" } },
        "status": { "type": "string", "enum": ["proposed", "active", "discharged", "cancelled", "breached"] },
        "proposed_by": { "$ref": "common.schema.json#/$defs/id" },
        "accepted_by": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" } },
        "created": { "$ref": "common.schema.json#/$defs/ts" }
      },
      "additionalProperties": false
    }
  ]
}
